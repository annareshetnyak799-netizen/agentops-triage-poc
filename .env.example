# ── Core ──────────────────────────────────────────────────────────────────
AGENTOPS_ENVIRONMENT=local
AGENTOPS_LOG_LEVEL=INFO
AGENTOPS_HOST=127.0.0.1
AGENTOPS_PORT=8000

# ── Persistence ────────────────────────────────────────────────────────────
# Options: inmemory | sqlite
AGENTOPS_REPOSITORY_BACKEND=inmemory
AGENTOPS_SQLITE_URL=sqlite:///./agentops_triage.db

# ── Bounded execution (docs/specs/memory-context.md §5) ────────────────────
AGENTOPS_MAX_TOOL_CALLS=6
AGENTOPS_TOOL_TIMEOUT_S=3
AGENTOPS_TIME_BUDGET_S=30
AGENTOPS_MAX_RETRIES=2

# ── Safety ────────────────────────────────────────────────────────────────
# Set to true to disable write/destructive tools (always off in PoC by default)
AGENTOPS_WRITE_TOOLS_ENABLED=false

# ── LLM backend ───────────────────────────────────────────────────────────
# Options: mock | openai
AGENTOPS_LLM_BACKEND=mock
AGENTOPS_LLM_PROVIDER=mock
AGENTOPS_LLM_MODEL=mock-model
AGENTOPS_LLM_TIMEOUT_S=15
# Required when AGENTOPS_LLM_BACKEND=openai
AGENTOPS_LLM_API_KEY=your-api-key-here

# ── Context window (docs/specs/memory-context.md §2.2) ────────────────────
AGENTOPS_MAX_OBSERVATIONS_IN_CONTEXT=5
AGENTOPS_MAX_OBSERVATION_CHARS=800

# ── Observability ──────────────────────────────────────────────────────────
# Set to true to enable OpenTelemetry tracing (ConsoleSpanExporter in PoC)
AGENTOPS_OTEL_ENABLED=false
AGENTOPS_OTEL_SERVICE_NAME=agentops-triage-poc

# ── Debug / test ──────────────────────────────────────────────────────────
# Force the degraded (partial_completed) path for manual testing
# AGENTOPS_FORCE_TOOL_FAILURE=false
